---
/**
 * Legacy group URLs forward to the single catalog with the group selected.
 * The client redirect preserves equipment filters and saved book anchors.
 */

export function getStaticPaths() {
	const files = import.meta.glob('../../../../data/servers/*/enchants.json', { eager: true, import: 'default' }) as Record<string, any>;
	return Object.entries(files).flatMap(([path, data]) => {
		const server = path.split('/').slice(-2)[0];
		return data.groups.map((group: any) => ({ params: { server, slug: group.slug }, props: { group } }));
	});
}

const { server } = Astro.params;
const { group } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const catalogPath = `${base}/${server}/enchants/danh-sach/`;
const destination = `${catalogPath}?nhom=${encodeURIComponent(group.slug)}`;
---

<!doctype html>
<html lang="vi">
	<head>
		<meta charset="utf-8" />
		<meta name="robots" content="noindex" />
		<link rel="canonical" href={new URL(catalogPath, Astro.site).href} />
		<title>Đang mở sách {group.name}</title>
		<script is:inline define:vars={{ catalogPath, groupSlug: group.slug }}>
			const destination = new URL(window.location.href);
			destination.pathname = catalogPath;
			destination.searchParams.set('nhom', groupSlug);
			window.location.replace(destination.href);
		</script>
		<meta http-equiv="refresh" content={`0;url=${destination}`} />
	</head>
	<body>
		<p><a href={destination}>Xem sách {group.name} trong danh sách sách phép.</a></p>
	</body>
</html>
