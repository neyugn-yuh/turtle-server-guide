---
/**
 * Recipes of the materials page, grouped by the recipe category (the place that crafts them). One row per recipe:
 * the ingredients on the left, an arrow, the result on the right. Every item that is a material of the guide
 * is a link to its detail page; the material the page is about is highlighted.
 * Used by MaterialList (the group pages) and by the detail page of a material.
 */
interface Props {
	server: string;
	recipes: any[];
	/** id (lower case) of the material the rows are shown for: its chip is highlighted */
	current?: string;
}

const { server, recipes, current } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const iconUrl = (name: string) => `${base}/minions/${name}.png`;
const num = (n: number) => n.toLocaleString('vi-VN', { maximumFractionDigits: 2 });
const CURRENCY: Record<string, string> = { money: 'Tiền' };
const currency = (name: string) => CURRENCY[name.toLowerCase()] ?? name;

const groups: { category: string; rows: any[] }[] = [];
for (const recipe of recipes) {
	let group = groups.find((g) => g.category === recipe.category);
	if (!group) groups.push((group = { category: recipe.category, rows: [] }));
	group.rows.push(recipe);
}
---

<div class="mr not-content">
	{
		groups.map((group) => (
			<section class="mr-group">
				<h4>{group.category}</h4>
				{group.rows.map((recipe: any) => (
					<div class="mr-row">
						<div class="mr-chips">
							{recipe.ingredients.map((item: any) => {
								const Tag = item.link ? 'a' : 'span';
								return (
									<Tag class:list={['mr-chip', { 'is-current': item.link && item.link === current }]} href={item.link ? `${base}/${server}/materials/item/${item.link}/` : undefined}>
										{item.icon && <img class="mr-icon" src={iconUrl(item.icon)} alt="" width="20" height="20" loading="lazy" onerror="this.hidden=true" />}
										<b class="mr-amount">{num(item.amount)}×</b>
										<span class="mr-name">{item.name}</span>
									</Tag>
								);
							})}
						</div>
						<span class="mr-arrow" aria-hidden="true">→</span>
						<div class="mr-chips">
							{recipe.results.map((item: any) => {
								const Tag = item.link ? 'a' : 'span';
								return (
									<Tag class:list={['mr-chip', 'mr-result', { 'is-current': item.link && item.link === current }]} href={item.link ? `${base}/${server}/materials/item/${item.link}/` : undefined}>
										{item.icon && <img class="mr-icon" src={iconUrl(item.icon)} alt="" width="20" height="20" loading="lazy" onerror="this.hidden=true" />}
										<b class="mr-amount">{num(item.amount)}×</b>
										<span class="mr-name">{item.name}</span>
									</Tag>
								);
							})}
						</div>
						{(recipe.chance < 100 || (recipe.cost && recipe.cost.amount > 0)) && (
							<p class="mr-meta">
								{recipe.chance < 100 && <>Tỉ lệ thành công {num(recipe.chance)}%. </>}
								{recipe.cost && recipe.cost.amount > 0 && <>Phí {num(recipe.cost.amount)} {currency(recipe.cost.currency)}.</>}
							</p>
						)}
					</div>
				))}
			</section>
		))
	}
</div>

<style>
	.mr-group {
		margin-bottom: 1rem;
	}
	.mr-group h4 {
		margin: 0 0 0.4rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
		font-weight: 600;
		letter-spacing: 0.02em;
	}
	.mr-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.75rem;
		margin-bottom: 0.5rem;
		padding: 0.6rem 0.75rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.5rem;
		background: var(--sl-color-gray-6);
	}
	.mr-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.mr-arrow {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-lg);
	}
	.mr-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.2rem 0.55rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.375rem;
		background: var(--sl-color-bg);
		color: var(--sl-color-text);
		font-size: var(--sl-text-sm);
		line-height: 1.3;
		text-decoration: none;
	}
	a.mr-chip:hover {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-accent-high);
	}
	.mr-result {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent-low);
	}
	.mr-chip.is-current {
		box-shadow: 0 0 0 1px var(--sl-color-accent);
	}
	.mr-icon {
		width: 1.25rem;
		height: 1.25rem;
		margin: 0;
		image-rendering: pixelated;
	}
	.mr-amount {
		color: var(--sl-color-accent-high);
		font-variant-numeric: tabular-nums;
	}
	.mr-meta {
		flex-basis: 100%;
		margin: 0;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}
</style>
