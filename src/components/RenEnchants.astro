---
/**
 * The enchant books (Sách phép) of Sky Rèn, built from src/data/servers/<server>/enchants.json
 * (written by scripts/sync-ren.mjs from the server's config). Two views:
 *   groups  every book group, weakest to strongest, with counts and prices
 *   group   one group (prop `slug`): each book with what it does, what it goes on and its levels
 * Book details, counts and prices come from the generated data.
 */
import RenEnchantNav from './RenEnchantNav.astro';

interface Props {
	server: string;
	view: 'groups' | 'group';
	/** group only: slug of the group, lower case */
	slug?: string;
}

const { server, view, slug } = Astro.props;
const files = import.meta.glob('../data/servers/*/enchants.json', { eager: true, import: 'default' }) as Record<string, any>;
const data = files[`../data/servers/${server}/enchants.json`];
if (!data) throw new Error(`RenEnchants: no enchants.json for server "${server}", run node scripts/sync-ren.mjs`);
const groups: any[] = data.groups;
const group = view === 'group' ? groups.find((g: any) => g.slug === slug) : null;
if (view === 'group' && !group) throw new Error(`RenEnchants: no group "${slug}" in enchants.json`);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const groupUrl = (s: string) => `${base}/${server}/enchants/nhom/${s}/`;
const num = (x: number) => x.toLocaleString('vi-VN', { maximumFractionDigits: 3 });
const ROMAN = ['', 'I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X', 'XI', 'XII'];
const roman = (n: number) => ROMAN[n] ?? String(n);
const levelText = (e: any) => (e.levels.length === 1 ? 'Cấp I' : `Cấp I–${roman(e.levels.length)}`);
const ref = (r: any) => `${r.name}${r.level ? ` ${roman(r.level)}` : ''}${r.group ? ` (${r.group})` : ''}`;
const lines = (e: any) => [
	e.requires.length ? `Cần trên vật phẩm: ${e.requires.map(ref).join(', ')}` : null,
	e.replaces.length ? `Thay thế: ${e.replaces.map(ref).join(', ')}` : null,
	e.excludes.length ? `Không ép cùng: ${e.excludes.map(ref).join(', ')}` : null,
].filter(Boolean) as string[];
const columns = (e: any) => ({
	chance: !e.passive,
	cooldown: !e.passive && e.levels.some((l: any) => l.cooldown > 0),
	souls: e.levels.some((l: any) => l.souls),
});
---

<div class="re not-content">
	<RenEnchantNav server={server} groups={groups} active={group?.slug} />

	{
		view === 'groups' && (
			<>
				<p>Chọn nhóm sách để xem tác dụng, trang bị phù hợp và chỉ số từng cấp.</p>
				<p class="re-meta">Xếp từ yếu đến mạnh. Huyết tử và Mạ vàng ngang cấp.</p>
				<div class="re-scroll">
					<table>
						<thead>
							<tr>
								<th scope="col">Nhóm sách</th>
								<th scope="col">Số sách phép</th>
								<th scope="col">Giá tại bảng Sách phép (EXP)</th>
							</tr>
						</thead>
						<tbody>
							{groups.map((g: any) => (
								<tr>
									<th scope="row">
										<span class="re-dot" style={g.color ? `background:${g.color}` : ''} aria-hidden="true" />
										<a href={groupUrl(g.slug)}>{g.name}</a>
									</th>
									<td>{num(g.enchants.length)}</td>
									<td>{g.priceExp !== null ? num(g.priceExp) : 'Không bán tại bảng này'}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</>
		)
	}

	{
		view === 'group' && (
			<>
				<p class="re-meta">
					{num(group.enchants.length)} sách phép loại {group.name}.
					{group.priceExp !== null && ` Mua ở bảng Sách phép với giá ${num(group.priceExp)} EXP mỗi lần.`}
					{group.randomLevelCap3 && ' Sách nhận ngẫu nhiên chỉ ra cấp 1–3.'}
				</p>
				<nav class="re-book-nav" aria-label={`Sách phép trong nhóm ${group.name}`}>
					<p class="re-nav-title">Sách trong nhóm</p>
					<ul class="re-index">
						{group.enchants.map((e: any) => (
							<li>
								<a href={`#${e.id}`}>{e.name}</a>
							</li>
						))}
					</ul>
				</nav>
				{group.enchants.map((e: any) => {
					const col = columns(e);
					return (
						<section class="re-book" id={e.id}>
							<h2>{e.name}</h2>
							<p class="re-meta">
								Ép lên: <strong>{e.appliesTo}</strong> · {e.passive ? `Thường trực khi mang trang bị, ${levelText(e)}` : levelText(e)}
							</p>
							<p>{e.description}</p>
							{lines(e).map((text) => (
								<p class="re-meta">{text}</p>
							))}
							{!e.passive && (
								<div class="re-scroll">
									<table>
										<thead>
											<tr>
												<th>Cấp</th>
												{col.chance && <th>Tỉ lệ kích hoạt</th>}
												{col.cooldown && <th>Hồi chiêu</th>}
												{col.souls && <th>Linh hồn mỗi lần</th>}
											</tr>
										</thead>
										<tbody>
											{e.levels.map((l: any) => (
												<tr>
													<td>{roman(l.level)}</td>
													{col.chance && <td>{num(l.chance)}%</td>}
													{col.cooldown && <td>{l.cooldown > 0 ? `${num(l.cooldown)} giây` : '–'}</td>}
													{col.souls && <td>{l.souls ? num(l.souls) : '–'}</td>}
												</tr>
											))}
										</tbody>
									</table>
								</div>
							)}
						</section>
					);
				})}
			</>
		)
	}
</div>

<style>
	.re {
		margin: 1.5rem 0;
	}
	.re h2 {
		margin: 1.5rem 0 0.25rem;
		font-size: var(--sl-text-2xl);
	}
	.re-meta {
		margin: 0.25rem 0 0.5rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}
	.re-dot {
		display: inline-block;
		width: 0.7rem;
		height: 0.7rem;
		margin-right: 0.45rem;
		border-radius: 50%;
		background: var(--sl-color-gray-4);
	}
	.re-index {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0.5rem 0 0;
		padding: 0;
		list-style: none;
		font-size: var(--sl-text-sm);
	}
	.re-book-nav {
		margin-top: 1rem;
		padding: 0.85rem 1rem;
		border: 1px solid var(--tw-border);
		border-radius: 0.5rem;
		background: var(--tw-neutral);
	}
	.re-nav-title {
		margin: 0;
		font-size: var(--sl-text-sm);
		font-weight: 600;
	}
	.re-index a {
		display: block;
		padding: 0.4rem 0.65rem;
		border: 1px solid var(--tw-border);
		border-radius: 0.25rem;
		color: var(--tw-text-nav);
		text-decoration: none;
	}
	.re-index a:hover {
		background: var(--tw-surface);
		color: var(--tw-accent-text);
	}
	.re-index a:focus-visible {
		outline: 2px solid var(--tw-accent-text);
		outline-offset: 2px;
	}
	.re-book {
		margin-top: 1.25rem;
		padding: 0.25rem 1rem 0.75rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.5rem;
	}
	.re-book:target {
		border-color: var(--tw-green);
	}
	.re-book h2 {
		font-size: var(--sl-text-xl);
	}
	.re-scroll {
		overflow-x: auto;
	}
	.re table {
		width: 100%;
		border-collapse: collapse;
		font-size: var(--sl-text-sm);
	}
	.re th,
	.re td {
		padding: 0.35rem 0.6rem;
		border-bottom: 1px solid var(--sl-color-hairline);
		text-align: left;
		white-space: nowrap;
		vertical-align: middle;
	}
	.re th {
		color: var(--sl-color-gray-2);
		font-weight: 600;
	}
</style>
