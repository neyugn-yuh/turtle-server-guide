---
/**
 * One dungeon of Sky Rèn, built from src/data/servers/<server>/dungeons.json
 * (written by scripts/sync-ren.mjs from the server's config): its mobs and, for each boss, what it gives
 * to whoever lands the killing blow and to the players around it.
 *
 * Pictures: mob faces are public/mobs/<entity>.png (scripts/fetch-mob-images.mjs), item pictures are
 * public/minions/<material>.png (scripts/fetch-minion-icons.mjs). A picture that does not exist is hidden.
 * Every number comes from the data, none is typed here. A column with nothing to show on a page is left out.
 */
interface Props {
	server: string;
	n: number;
}

const { server, n } = Astro.props;
const files = import.meta.glob('../data/servers/*/dungeons.json', { eager: true, import: 'default' }) as Record<string, any>;
const data = files[`../data/servers/${server}/dungeons.json`];
if (!data) throw new Error(`RenDungeon: no dungeons.json for server "${server}", run node scripts/sync-ren.mjs`);
const dungeon = data.dungeons.find((d: any) => d.n === n);
if (!dungeon) throw new Error(`RenDungeon: no dungeon ${n} in dungeons.json`);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const mobUrl = (appearance: string | null) => (appearance ? `${base}/mobs/${appearance.toLowerCase()}.png` : '');
const chestUrl = (id: string) => `${base}/${server}/chests/item/${id}/`;
const iconUrl = (icon: string | null) => (icon ? `${base}/minions/${icon}.png` : '');
const num = (x: number) => x.toLocaleString('vi-VN', { maximumFractionDigits: 3 });
const range = (min: number, max: number) => (min === max ? num(min) : `${num(min)}–${num(max)}`);
const chance = (c: number) => (c >= 100 ? 'Chắc chắn' : `${num(c)}%`);
const stars = '★'.repeat(dungeon.difficulty.stars) + '☆'.repeat(dungeon.difficulty.max - dungeon.difficulty.stars);
const reachText = (g: any) => (g.limit ? `Tối đa ${num(g.limit)} người chơi ngẫu nhiên trong bán kính ${num(g.reach)} block quanh boss` : `Mọi người chơi trong bán kính ${num(g.reach)} block quanh boss`);
const normal = dungeon.mobs.filter((m: any) => m.kind === 'normal');
const bosses = dungeon.mobs.filter((m: any) => m.kind === 'boss');
const hasExp = normal.some((m: any) => m.exp !== null);
const hasMoney = normal.some((m: any) => m.money);
---

<div class="rd not-content">
	<p class="rd-meta">
		Độ khó: <strong class="rd-stars">{stars}</strong> ({dungeon.difficulty.label}). Boss cuối: <strong>{dungeon.finalBoss}</strong>.
	</p>
	<p class="rd-meta">
		Quái thường chỉ thưởng cho người kết liễu nó. Boss thưởng cho người kết liễu và cho người chơi đứng quanh boss; mỗi nhóm thưởng được chọn riêng nên một người có thể nhận nhiều nhóm. Tỉ lệ "Chắc chắn" là lần nào cũng nhận. Hình quái là hình minh họa theo loại quái.
	</p>

	<h2 id="quai-thuong">Quái thường</h2>
	<div class="rd-scroll">
		<table>
			<thead>
				<tr>
					<th>Quái</th>
					<th>Máu</th>
					<th>Sát thương</th>
					{hasExp && <th>Kinh nghiệm</th>}
					{hasMoney && <th>Tiền</th>}
					<th>Vật phẩm rơi</th>
				</tr>
			</thead>
			<tbody>
				{
					normal.map((m: any) => (
						<tr>
							<td>
								<img class="rd-mob" src={mobUrl(m.appearance)} alt="" width="32" height="32" loading="lazy" onerror="this.hidden=true" />
								{m.name}
							</td>
							<td>{num(m.health)}</td>
							<td>{m.damage ? num(m.damage) : '–'}</td>
							{hasExp && <td>{m.exp === null ? '–' : num(m.exp)}</td>}
							{hasMoney && <td>{m.money ? `${num(m.money.amount)} (${chance(m.money.chance)})` : '–'}</td>}
							<td class="rd-wrap">
								{m.drops.length === 0 ? (
									'–'
								) : (
									<ul class="rd-drops">
										{m.drops.map((r: any) => (
											<li>
												{r.icon ? <img class="rd-icon" src={iconUrl(r.icon)} alt="" width="20" height="20" loading="lazy" onerror="this.style.visibility='hidden'" /> : <span class="rd-icon rd-icon-empty" />}
												{r.type === 'currency' ? `${range(r.min, r.max)} ${r.name}` : `${r.name} ×${range(r.min, r.max)}`} <span class="rd-chance">({chance(r.chance)})</span>
											</li>
										))}
									</ul>
								)}
							</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</div>

	{
		bosses.map((boss: any) => (
			<section class="rd-boss">
				<h2 id={boss.id.toLowerCase()}>
					<img class="rd-mob rd-mob-lg" src={mobUrl(boss.appearance)} alt="" width="48" height="48" loading="lazy" onerror="this.hidden=true" />
					Boss: {boss.name}
				</h2>
				<p class="rd-meta">
					{boss.title && <>{boss.title}. </>}
					Máu <strong>{num(boss.health)}</strong>, sát thương <strong>{boss.damage ? num(boss.damage) : '–'}</strong>
					{boss.exp !== null && <>, kinh nghiệm {num(boss.exp)}</>}
					{boss.money && <>, tiền {num(boss.money.amount)} ({chance(boss.money.chance)})</>}.
				</p>

				{boss.killer.length > 0 && (
					<>
						<h3>Người kết liễu nhận</h3>
						<p class="rd-meta">Thưởng cho đúng một người: người tung đòn kết liễu boss.</p>
						<div class="rd-scroll">
							<table>
								<thead>
									<tr>
										<th>Phần thưởng</th>
										<th>Số lượng</th>
										<th>Tỉ lệ</th>
									</tr>
								</thead>
								<tbody>
									{boss.killer.map((r: any) => (
										<tr>
											<td>
												{r.icon ? <img class="rd-icon" src={iconUrl(r.icon)} alt="" width="20" height="20" loading="lazy" onerror="this.style.visibility='hidden'" /> : <span class="rd-icon rd-icon-empty" />}
												{r.type === 'chest' ? <a href={chestUrl(r.chest)}>{r.name}</a> : r.name}
											</td>
											<td>{range(r.min, r.max)}</td>
											<td>{chance(r.chance)}</td>
										</tr>
									))}
								</tbody>
							</table>
						</div>
					</>
				)}

				{boss.nearby.map((g: any, i: number) => (
					<>
						<h3>Người chơi ở gần nhận (nhóm {i + 1})</h3>
						<p class="rd-meta">{reachText(g)}.</p>
						<div class="rd-scroll">
							<table>
								<thead>
									<tr>
										<th>Phần thưởng</th>
										<th>Số lượng</th>
									</tr>
								</thead>
								<tbody>
									{g.rewards.map((r: any) => (
										<tr>
											<td>
												{r.icon ? <img class="rd-icon" src={iconUrl(r.icon)} alt="" width="20" height="20" loading="lazy" onerror="this.style.visibility='hidden'" /> : <span class="rd-icon rd-icon-empty" />}
												{r.type === 'chest' ? <a href={chestUrl(r.chest)}>{r.name}</a> : r.name}
											</td>
											<td>{range(r.min, r.max)}</td>
										</tr>
									))}
								</tbody>
							</table>
						</div>
					</>
				))}
			</section>
		))
	}
</div>

<style>
	.rd {
		margin: 1.5rem 0;
	}
	.rd h2 {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 1.5rem 0 0.25rem;
		font-size: var(--sl-text-2xl);
	}
	.rd h3 {
		margin: 1rem 0 0.25rem;
		font-size: var(--sl-text-lg);
	}
	.rd-meta {
		margin: 0.25rem 0 0.5rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}
	.rd-boss {
		margin-top: 1.5rem;
		padding: 0.25rem 1rem 0.75rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.5rem;
	}
	.rd-scroll {
		overflow-x: auto;
	}
	.rd table {
		width: 100%;
		border-collapse: collapse;
		font-size: var(--sl-text-sm);
	}
	.rd th,
	.rd td {
		padding: 0.35rem 0.6rem;
		border-bottom: 1px solid var(--sl-color-hairline);
		text-align: left;
		white-space: nowrap;
		vertical-align: middle;
	}
	.rd th {
		color: var(--sl-color-gray-2);
		font-weight: 600;
	}
	.rd td.rd-wrap {
		white-space: normal;
		min-width: 18rem;
	}
	.rd-stars {
		letter-spacing: 0.05em;
	}
	/* pictures are pixel art: enlarge without smoothing */
	.rd img {
		image-rendering: pixelated;
		vertical-align: middle;
	}
	.rd-mob {
		margin-right: 0.5rem;
	}
	.rd-mob-lg {
		margin-right: 0;
	}
	.rd-icon {
		margin-right: 0.35rem;
	}
	.rd-icon-empty {
		display: inline-block;
		width: 20px;
		height: 20px;
		vertical-align: middle;
	}
	.rd-drops {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.rd-drops li {
		margin: 0.15rem 0;
	}
	.rd-chance {
		color: var(--sl-color-gray-3);
	}
</style>
