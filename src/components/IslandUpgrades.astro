---
/**
 * The six island upgrades of one server, built from src/data/servers/<server>/island-upgrades.json
 * (written by scripts/sync-island-upgrades.mjs from the server's config). One section per upgrade: what it does, then a
 * table with what every level gives, what it costs and the total to reach the top. The ore upgrade also gets the ore chances
 * of every generator level.
 */
import { upgradeIcons } from '../data/island-upgrade-icons.mjs';

interface Props {
	server: string;
}

const { server } = Astro.props;
const files = import.meta.glob('../data/servers/*/island-upgrades.json', { eager: true, import: 'default' }) as Record<string, any>;
const data = files[`../data/servers/${server}/island-upgrades.json`];
if (!data) throw new Error(`IslandUpgrades: no island-upgrades.json for server "${server}", run node scripts/sync-island-upgrades.mjs`);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const iconUrl = (name: string) => `${base}/minions/${name}.png`;
const num = (n: number) => n.toLocaleString('vi-VN', { maximumFractionDigits: 2 });

const BLOCKS: Record<string, string> = { IRON_BLOCK: 'Khối Sắt', GOLD_BLOCK: 'Khối Vàng', DIAMOND_BLOCK: 'Khối Kim Cương', EMERALD_BLOCK: 'Khối Lục Bảo' };
const blockName = (material: string) => BLOCKS[material] ?? material.toLowerCase().replace(/_/g, ' ');
const STATS: Record<string, string> = { MAX_HEALTH: 'Máu tối đa', ATTACK_DAMAGE: 'Sát thương', DEFENSE: 'Phòng thủ' };
const statName = (stat: string) => STATS[stat] ?? stat.toLowerCase().replace(/_/g, ' ');

// What a level gives, and the row of the default state (before any upgrade).
const text: Record<string, { title: string; intro: string; base: string; effect: (l: any) => string }> = {
	'border-size': {
		title: 'Diện tích đảo',
		intro: 'Mở rộng vùng đất bạn được xây dựng. Số block là cạnh của vùng vuông, tính quanh tâm đảo.',
		base: `${num(data.upgrades[0].baseValue * 2)} × ${num(data.upgrades[0].baseValue * 2)} block`,
		effect: (l) => `${num(l.value * 2)} × ${num(l.value * 2)} block`,
	},
	'members-limit': {
		title: 'Thành viên đảo',
		intro: 'Tăng số người tối đa được ở trong đảo, tính cả chủ đảo.',
		base: `${num(data.upgrades[1].baseValue)} thành viên`,
		effect: (l) => `${num(l.value)} thành viên`,
	},
	'minion-slots': {
		title: 'Slot đặt minion',
		intro: 'Bảo đảm đảo có ít nhất ngần ấy slot đặt minion. Server lấy số lớn hơn giữa mức này và slot bạn có từ minion mới chế, rồi cộng thêm slot mua ở cửa hàng, nên nâng cấp không bị mất slot đã có.',
		base: `${num(data.upgrades[2].baseValue)} slot`,
		effect: (l) => `Tối thiểu ${num(l.value)} slot`,
	},
	ore: {
		title: 'Máy tạo quặng',
		intro: 'Quyết định khối nào sinh ra khi nước và dung nham gặp nhau trên đảo. Cấp càng cao thì càng ít đá, nhiều quặng quý và khối quặng hơn. Tỉ lệ từng cấp ở bảng bên dưới.',
		base: 'Máy quặng mặc định (nhiều đá, ít quặng)',
		effect: (l) => `Máy quặng cấp ${num(l.value)}`,
	},
	'dungeon-stats': {
		title: 'Chỉ số dungeon',
		intro: `Cộng chỉ số cho mọi thành viên khi đứng trong thế giới dungeon (${data.dungeonWorlds.join(', ')}). Mức ghi là tổng ở cấp đó, không cộng dồn các cấp trước. Ở ngoài dungeon thì không có tác dụng.`,
		base: 'Chưa có chỉ số cộng thêm',
		effect: (l) => Object.entries(l.stats).map(([stat, value]) => `${statName(stat)} +${value}`).join(', '),
	},
	forge: {
		title: 'Xưởng rèn',
		intro: 'Mở khóa công thức chế tạo của từng tầng. Tầng 1 mở sẵn; mỗi cấp xưởng rèn mở thêm công thức của một tầng kế tiếp.',
		base: 'Chỉ có công thức Tầng 1',
		effect: (l) => `Mở công thức Tầng ${l.value + 1}`,
	},
};

const sections = data.upgrades.map((upgrade: any) => {
	const copy = text[upgrade.id];
	if (!copy) throw new Error(`IslandUpgrades: no text for upgrade "${upgrade.id}"`);
	const totalMoney = upgrade.levels.reduce((sum: number, l: any) => sum + l.money, 0);
	const totalItems: Record<string, number> = {};
	for (const level of upgrade.levels) for (const [material, amount] of Object.entries(level.items) as [string, number][]) totalItems[material] = (totalItems[material] ?? 0) + amount;
	const first = upgrade.levels[0].display;
	return { ...copy, id: upgrade.id, levels: upgrade.levels, totalMoney, totalItems, hasItems: Object.keys(totalItems).length > 0, baseLabel: first === 0 ? 'Mặc định' : `Cấp ${first - 1} (mặc định)`, icon: upgradeIcons[upgrade.id] };
});

const OREC = [
	['STONE', 'Đá'],
	['COAL_ORE', 'Than'],
	['IRON_ORE', 'Sắt'],
	['REDSTONE_ORE', 'Đá đỏ'],
	['LAPIS_ORE', 'Lưu ly'],
	['GOLD_ORE', 'Vàng'],
	['DIAMOND_ORE', 'Kim cương'],
	['EMERALD_ORE', 'Lục bảo'],
	['BLOCKS', 'Khối quặng'],
];
const percent = (n: number) => (n === 0 ? '–' : `${num(n)}%`);
---

<div class="iu not-content">
	{
		sections.map((section: any) => (
			<section class="iu-section">
				<h3 id={section.id}>
					{section.icon && <img class="iu-icon" src={iconUrl(section.icon)} alt="" width="28" height="28" loading="lazy" onerror="this.hidden=true" />}
					{section.title}
				</h3>
				<p>{section.intro}</p>
				<div class="iu-scroll">
					<table>
						<thead>
							<tr>
								<th>Cấp</th>
								<th>Nhận được</th>
								<th>Tiền</th>
								{section.hasItems && <th>Khối phải nộp</th>}
							</tr>
						</thead>
						<tbody>
							<tr class="iu-base">
								<td>{section.baseLabel}</td>
								<td>{section.base}</td>
								<td>–</td>
								{section.hasItems && <td>–</td>}
							</tr>
							{section.levels.map((level: any) => (
								<tr>
									<td>{level.display}</td>
									<td>{section.effect(level)}</td>
									<td>{num(level.money)}</td>
									{section.hasItems && (
										<td>
											{Object.keys(level.items).length === 0
												? '–'
												: Object.entries(level.items).map(([material, amount]: [string, any]) => (
														<span class="iu-item">
															<img class="iu-icon-sm" src={iconUrl(material.toLowerCase())} alt="" width="18" height="18" loading="lazy" onerror="this.hidden=true" />
															{num(amount)} {blockName(material)}
														</span>
													))}
										</td>
									)}
								</tr>
							))}
						</tbody>
						<tfoot>
							<tr>
								<td colspan="2">Tổng để lên cấp tối đa</td>
								<td>{num(section.totalMoney)}</td>
								{section.hasItems && (
									<td>
										{Object.entries(section.totalItems).map(([material, amount]: [string, any]) => (
											<span class="iu-item">
												<img class="iu-icon-sm" src={iconUrl(material.toLowerCase())} alt="" width="18" height="18" loading="lazy" onerror="this.hidden=true" />
												{num(amount)} {blockName(material)}
											</span>
										))}
									</td>
								)}
							</tr>
						</tfoot>
					</table>
				</div>
				{section.id === 'ore' && (
					<>
						<h4>Tỉ lệ khối sinh ra theo cấp máy quặng</h4>
						<p class="iu-small">Mỗi số là xác suất một khối mới sinh ra thuộc loại đó. “Khối quặng” gồm các khối nguyên (khối than, sắt, vàng, kim cương...).</p>
						<div class="iu-scroll">
							<table>
								<thead>
									<tr>
										<th>Cấp</th>
										{OREC.map(([, label]) => <th>{label}</th>)}
									</tr>
								</thead>
								<tbody>
									{data.ore.map((row: any) => (
										<tr>
											<td>{row.level === 0 ? '0 (mặc định)' : row.level}</td>
											{OREC.map(([key]) => <td>{percent(row[key])}</td>)}
										</tr>
									))}
								</tbody>
							</table>
						</div>
					</>
				)}
			</section>
		))
	}
	<p class="iu-note">Giá tính bằng Tiền. Quặng và khối phải nộp lấy từ túi của người bấm nâng cấp.</p>
</div>

<style>
	.iu {
		margin: 1.5rem 0;
	}
	.iu-section h3 {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 2rem 0 0.5rem;
		font-size: var(--sl-text-xl);
	}
	.iu-section h4 {
		margin: 1.25rem 0 0.25rem;
		font-size: var(--sl-text-base);
	}
	.iu-icon {
		width: 1.75rem;
		height: 1.75rem;
		margin: 0;
		image-rendering: pixelated;
	}
	.iu-icon-sm {
		width: 1.125rem;
		height: 1.125rem;
		margin: 0 0.3rem 0 0;
		vertical-align: middle;
		image-rendering: pixelated;
	}
	.iu-item {
		display: inline-block;
		margin-right: 0.75rem;
		white-space: nowrap;
	}
	.iu-scroll {
		overflow-x: auto;
	}
	.iu table {
		width: 100%;
		border-collapse: collapse;
		font-size: var(--sl-text-sm);
	}
	.iu th,
	.iu td {
		padding: 0.35rem 0.6rem;
		border-bottom: 1px solid var(--sl-color-hairline);
		text-align: left;
		white-space: nowrap;
	}
	.iu th {
		color: var(--sl-color-gray-2);
		font-weight: 600;
	}
	.iu .iu-base td {
		color: var(--sl-color-gray-3);
	}
	.iu tfoot td {
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.iu-small,
	.iu-note {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}
</style>
