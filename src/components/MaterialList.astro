---
/**
 * List of the materials (nguyên liệu) of one server, built from src/data/servers/<server>/materials.json
 * (written by scripts/sync-materials.mjs from the server's config). One card per material with a short summary
 * (where it comes from, how many uses it has); the card links to the detail page of the material
 * (src/pages/[server]/materials/item/[id].astro).
 */
interface Props {
	server: string;
	/** only the materials of this group (id in src/data/material-categories.mjs); all when left out */
	category?: string;
}

const { server, category } = Astro.props;
const files = import.meta.glob('../data/servers/*/materials.json', { eager: true, import: 'default' }) as Record<string, any>;
const data = files[`../data/servers/${server}/materials.json`];
if (!data) throw new Error(`MaterialList: no materials.json for server "${server}", run node scripts/sync-materials.mjs`);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const iconUrl = (name: string) => `${base}/minions/${name}.png`;
const num = (n: number) => n.toLocaleString('vi-VN', { maximumFractionDigits: 2 });

const materials: any[] = category ? data.materials.filter((m: any) => m.category === category) : data.materials;
if (category && materials.length === 0) throw new Error(`MaterialList: no material in group "${category}"`);

/** "tầng 1–4" / "tầng 2, 5": the floors a material drops on */
function floorsText(sources: any[]) {
	const floors = [...new Set(sources.map((s) => s.floor))].sort((a, b) => a - b);
	if (floors.length === 1) return `tầng ${floors[0]}`;
	const consecutive = floors.every((f, i) => i === 0 || f === floors[i - 1] + 1);
	return consecutive ? `tầng ${floors[0]}–${floors[floors.length - 1]}` : `tầng ${floors.join(', ')}`;
}

function summary(material: any) {
	const tags: string[] = [];
	if (material.sources.length > 0) tags.push(`Rớt ${floorsText(material.sources)}`);
	if (material.recipes.length > 0) tags.push('Chế tạo');
	const uses = material.uses.length + material.upgrades.length;
	if (uses > 0) tags.push(`${num(uses)} công dụng`);
	const noWay = material.sources.length === 0 && material.recipes.length === 0 && material.category !== 'khoang-san' && material.category !== 'nong-san';
	return { tags, noWay };
}
---

<div class="ml not-content">
	{
		materials.map((material: any) => {
			const { tags, noWay } = summary(material);
			return (
				<a class="ml-card" id={material.id.toLowerCase()} href={`${base}/${server}/materials/item/${material.id.toLowerCase()}/`}>
					{material.icon && <img class="ml-icon" src={iconUrl(material.icon)} alt="" width="32" height="32" loading="lazy" onerror="this.hidden=true" />}
					<span class="ml-body">
						<span class="ml-name">{material.name}</span>
						<span class="ml-tags">
							{tags.map((tag) => <span class="ml-tag">{tag}</span>)}
							{noWay && <span class="ml-tag ml-warn">Chưa có cách nhận</span>}
						</span>
					</span>
					<span class="ml-go" aria-hidden="true">›</span>
				</a>
			);
		})
	}
</div>

<style>
	.ml {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
		gap: 0.75rem;
		margin: 1.5rem 0;
	}
	.ml-card {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.75rem 1rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.5rem;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-text);
		text-decoration: none;
	}
	.ml-card:hover {
		border-color: var(--sl-color-accent);
	}
	.ml-icon {
		flex: none;
		width: 2rem;
		height: 2rem;
		margin: 0;
		image-rendering: pixelated;
	}
	.ml-body {
		display: grid;
		flex: 1;
		gap: 0.3rem;
		min-width: 0;
	}
	.ml-name {
		font-weight: 600;
	}
	.ml-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem;
	}
	.ml-tag {
		padding: 0.05rem 0.5rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-xs);
	}
	.ml-warn {
		border-color: var(--sl-color-orange);
		color: var(--sl-color-orange-high);
	}
	.ml-go {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xl);
	}
</style>
