---
/**
 * The reward chests of Sky Rèn, built from src/data/servers/<server>/chests.json
 * (written by scripts/sync-ren.mjs from the server's config). Two views:
 *   list    every chest as a card, grouped (boss chests, spawner chests, Lửa Phép chests); the cards link to the detail page
 *   detail  one chest (prop `id`): what one opening gives, every reward with its chance, and where the chest comes from
 * Pictures are public/minions/<material>.png (scripts/fetch-minion-icons.mjs); a picture that does not exist is hidden.
 * Every number comes from the data, none is typed here.
 */
interface Props {
	server: string;
	view: 'list' | 'detail';
	/** detail only: slug of the chest, lower case */
	id?: string;
}

const { server, view, id } = Astro.props;
const files = import.meta.glob('../data/servers/*/chests.json', { eager: true, import: 'default' }) as Record<string, any>;
const data = files[`../data/servers/${server}/chests.json`];
if (!data) throw new Error(`RenChests: no chests.json for server "${server}", run node scripts/sync-ren.mjs`);
const chests: any[] = data.chests;
const chest = view === 'detail' ? chests.find((c: any) => c.id === id) : null;
if (view === 'detail' && !chest) throw new Error(`RenChests: no chest "${id}" in chests.json`);

// the chance of each gem in a Lửa Phép chest is not shown to players
const showChance = chest ? chest.kind !== 'lua-phep' : true;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const iconUrl = (icon: string | null) => (icon ? `${base}/minions/${icon}.png` : '');
const chestUrl = (slug: string) => `${base}/${server}/chests/item/${slug}/`;
const dungeonUrl = (n: number) => `${base}/${server}/dungeons/dungeon-${n}/`;
const num = (x: number) => x.toLocaleString('vi-VN', { maximumFractionDigits: 3 });
const range = (min: number, max: number) => (min === max ? num(min) : `${num(min)}–${num(max)}`);
const byId = (slug: string) => chests.find((c: any) => c.id === slug);
const GROUPS = [
	{ kind: 'boss', title: 'Rương quà Boss Dungeon', note: 'Boss dungeon thưởng cho người kết liễu.' },
	{ kind: 'spawner', title: 'Rương Spawner', note: 'Boss dungeon thưởng cho người chơi đứng gần khi boss chết.' },
	{ kind: 'lua-phep', title: 'Rương Lửa Phép', note: 'Lửa phép dùng để phù phép sọ.' },
];
const opens = (c: any) => (c.min === c.max ? `Mở nhận ${num(c.min)} phần thưởng` : `Mở nhận ${range(c.min, c.max)} phần thưởng`);
const sourceText = (s: any) => {
	if (s.type === 'chest') return null;
	if (s.who === 'killer') return 'Thưởng cho người kết liễu boss';
	const who = s.limit ? `Tối đa ${num(s.limit)} người chơi ngẫu nhiên` : 'Mọi người chơi';
	return `${who} trong bán kính ${num(s.reach)} block quanh boss khi nó chết`;
};
---

<div class="rc not-content">
	{
		view === 'list' &&
			GROUPS.map((group) => (
				<section>
					<h2 id={group.kind}>{group.title}</h2>
					<p class="rc-meta">{group.note}</p>
					<div class="rc-grid">
						{chests
							.filter((c: any) => c.kind === group.kind)
							.map((c: any) => (
								<a class="rc-card" href={chestUrl(c.id)}>
									<img class="rc-icon" src={iconUrl(c.icon)} alt="" width="32" height="32" loading="lazy" onerror="this.style.visibility='hidden'" />
									<span>
										<strong>{c.name}</strong>
										<small>{opens(c)}</small>
									</span>
								</a>
							))}
					</div>
				</section>
			))
	}

	{
		view === 'detail' && (
			<>
				<p class="rc-head">
					<img class="rc-icon rc-icon-lg" src={iconUrl(chest.icon)} alt="" width="48" height="48" onerror="this.style.visibility='hidden'" />
					<span>
						Mỗi lần mở rương nhận <strong>{chest.min === chest.max ? `đúng ${num(chest.min)}` : `từ ${num(chest.min)} đến ${num(chest.max)}`}</strong> phần thưởng, chọn ngẫu nhiên trong bảng dưới.{showChance && ' Cột Tỉ lệ là xác suất của từng phần thưởng.'}
					</span>
				</p>

				<h2 id="phan-thuong">Phần thưởng</h2>
				<div class="rc-scroll">
					<table>
						<thead>
							<tr>
								<th>Phần thưởng</th>
								<th>Số lượng</th>
								{showChance && <th>Tỉ lệ</th>}
							</tr>
						</thead>
						<tbody>
							{chest.rewards.map((r: any) => (
								<tr>
									<td>
										{r.icon ? <img class="rc-icon-sm" src={iconUrl(r.icon)} alt="" width="20" height="20" loading="lazy" onerror="this.style.visibility='hidden'" /> : <span class="rc-icon-sm rc-icon-empty" />}
										{r.type === 'chest' ? <a href={chestUrl(r.chest)}>{r.name}</a> : r.name}
									</td>
									<td>{range(r.min, r.max)}</td>
									{showChance && <td>{num(r.chance)}%</td>}
								</tr>
							))}
						</tbody>
					</table>
				</div>
				{showChance && chest.total !== 100 && <p class="rc-meta">Tổng các tỉ lệ ghi trong cấu hình của rương này là {num(chest.total)}.</p>}

				<h2 id="cach-nhan">Cách nhận</h2>
				<ul class="rc-sources">
					{chest.sources.map((s: any) =>
						s.type === 'chest' ? (
							<li>
								Mở ra từ <a href={chestUrl(s.chest)}>{byId(s.chest).name}</a>{showChance ? ` (tỉ lệ ${num(byId(s.chest).rewards.find((r: any) => r.chest === chest.id).chance)}%).` : '.'}
							</li>
						) : (
							<li>
								<a href={dungeonUrl(s.dungeon)}>Dungeon {s.dungeon}</a>, boss <strong>{s.boss}</strong>: {sourceText(s)}.
							</li>
						),
					)}
				</ul>
			</>
		)
	}
</div>

<style>
	.rc {
		margin: 1.5rem 0;
	}
	.rc h2 {
		margin: 1.5rem 0 0.25rem;
		font-size: var(--sl-text-2xl);
	}
	.rc-meta {
		margin: 0.25rem 0 0.5rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}
	.rc-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
		gap: 0.75rem;
	}
	.rc-card {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.75rem 1rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.5rem;
		color: inherit;
		text-decoration: none;
	}
	.rc-card:hover {
		border-color: var(--sl-color-text-accent);
	}
	.rc-card small {
		display: block;
		color: var(--sl-color-gray-3);
	}
	.rc-head {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}
	.rc img {
		image-rendering: pixelated;
		vertical-align: middle;
	}
	.rc-icon-sm {
		margin-right: 0.35rem;
	}
	.rc-icon-empty {
		display: inline-block;
		width: 20px;
		height: 20px;
		vertical-align: middle;
	}
	.rc-scroll {
		overflow-x: auto;
	}
	.rc table {
		width: 100%;
		border-collapse: collapse;
		font-size: var(--sl-text-sm);
	}
	.rc th,
	.rc td {
		padding: 0.35rem 0.6rem;
		border-bottom: 1px solid var(--sl-color-hairline);
		text-align: left;
		white-space: nowrap;
		vertical-align: middle;
	}
	.rc th {
		color: var(--sl-color-gray-2);
		font-weight: 600;
	}
	.rc-sources {
		margin: 0.25rem 0;
		padding-left: 1.25rem;
		font-size: var(--sl-text-sm);
	}
</style>
