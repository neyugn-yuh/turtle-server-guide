---
/**
 * The equipment of Sky Rèn (armor sets, swords, axes, bows, shields, pickaxes), built from src/data/servers/<server>/gear.json
 * (written by scripts/sync-ren.mjs, scripts/ren-equipment.mjs, from the server's config). Three views:
 *   sets   searchable, line-filterable armor set catalog with icons, base 4-piece stats & bonus previews
 *   set    one set (prop `id`): sibling switcher, 4-piece stat summary, bonus showcase, unified armor table & paired weapons
 *   kind   searchable, upgrade-grouped weapon/tool catalog (prop `kind`: sword, axe, farm-axe, bow, shield, pickaxe)
 * Every number and name comes from the data, none is typed here.
 */
import RenItemTable from './RenItemTable.astro';
import { hasMinionIcon, resolveGearIcon } from '../lib/ren-icons';

interface Props {
	server: string;
	view: 'sets' | 'set' | 'kind';
	id?: string;
	kind?: 'sword' | 'axe' | 'farm-axe' | 'bow' | 'shield' | 'pickaxe';
}

const { server, view, id, kind } = Astro.props;
const files = import.meta.glob('../data/servers/*/gear.json', { eager: true, import: 'default' }) as Record<string, any>;
const data = files[`../data/servers/${server}/gear.json`];
if (!data) throw new Error(`RenEquipment: no gear.json for server "${server}", run node scripts/sync-ren.mjs`);

const items: any[] = data.items;
const sets: any[] = data.sets;
const byKey = new Map(items.map((i: any) => [i.key, i]));

const set = view === 'set' ? sets.find((s: any) => s.id === id) : null;
if (view === 'set' && !set) throw new Error(`RenEquipment: no set "${id}" in gear.json`);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const setUrl = (slug: string) => `${base}/${server}/gear/bo/${slug}/`;
const hasIcon = (icon: string | null | undefined) => hasMinionIcon(icon);
const num = (x: number) => x.toLocaleString('vi-VN', { maximumFractionDigits: 3 });

const SLOTS: [string, string][] = [
	['helmet', 'Mũ'],
	['chestplate', 'Áo'],
	['leggings', 'Quần'],
	['boots', 'Giày'],
];


// Lookup maps for cross-linking items <-> armor sets
const itemSets: Record<string, { id: string; slug: string; name: string }[]> = {};
for (const s of sets) {
	const info = { id: s.id, slug: s.slug, name: s.name };
	for (const [slot] of SLOTS) {
		for (const k of s.pieces[slot] ?? []) {
			(itemSets[k] ??= []).push(info);
		}
	}
	for (const w of s.weapons ?? []) {
		for (const k of w.items ?? []) {
			if (!(itemSets[k] ?? []).some((x) => x.id === s.id)) {
				(itemSets[k] ??= []).push(info);
			}
		}
	}
}
const itemIndex: Record<string, { kind: string; slug: string; name: string; icon?: string | null; dyeColor?: string | null }> = {};
for (const i of items) {
	itemIndex[i.key] = { kind: i.kind, slug: i.id.toLowerCase(), name: i.name, icon: i.icon, dyeColor: i.dyeColor };
}

const pieceText = (count: number) =>
	count === 4 ? 'Mặc đủ 4 món giáp' : count === 5 ? 'Đủ 4 món + cầm vũ khí bộ' : `Đủ ${count} món`;

const anchor = (text: string) =>
	text
		.toLowerCase()
		.normalize('NFD')
		.replace(/[\u0300-\u036f]/g, '')
		.replace(/đ/g, 'd')
		.replace(/\s+/g, '-');

// Compute 4-piece combined stats for a set (supports single-tier and multi-tier like huyetmavuong)
function setStatSummary(s: any) {
	const statDefs: [string, string, string][] = [
		['maxHealth', 'Máu tối đa', ''],
		['armor', 'Giáp', ''],
		['defense', 'Phòng thủ', ''],
		['damageReduction', 'Giảm ST', '%'],
	];
	const result: { key: string; label: string; text: string }[] = [];
	for (const [statKey, label, unit] of statDefs) {
		let minSum = 0;
		let maxSum = 0;
		let hasAny = false;
		for (const [slot] of SLOTS) {
			const pieces = (s.pieces[slot] ?? []).map((k: string) => byKey.get(k)).filter(Boolean);
			const vals = pieces.map((p: any) => p.stats?.[statKey]).filter((v: any) => Number.isFinite(v));
			if (vals.length) {
				hasAny = true;
				minSum += Math.min(...vals);
				maxSum += Math.max(...vals);
			}
		}
		if (hasAny) {
			const text = minSum === maxSum ? `+${num(minSum)}${unit}` : `+${num(minSum)}–${num(maxSum)}${unit}`;
			result.push({ key: statKey, label, text });
		}
	}
	return result;
}

// Short readable bonus summary for set cards
function bonusPreview(line: string) {
	return line
		.replace(/^Khi bị người chơi hoặc quái tấn công và máu từ (\d+)% trở xuống, hồi chiêu (\d+) giây: /, 'Máu ≤$1% ($2s): ')
		.replace(/^Khi bị ([^,]+) tấn công/, 'Khi bị $1 đánh')
		.replace(/sát thương gây ra/g, 'ST gây ra')
		.replace(/sát thương nhận/g, 'ST nhận')
		.replace(/\(từ người chơi, cung tên\)/g, '(PvP/cung)')
		.replace(/\(từ quái\)/g, '(quái)')
		.replace(/Luôn có hiệu ứng /g, '');
}

// Pre-resolve dyed leather icons for set cards & set detail slot preview
const setCardIcons: Record<string, { chestSrc: string; helmSrc: string }> = {};
if (view === 'sets') {
	await Promise.all(
		sets.map(async (s: any) => {
			const chest = byKey.get(s.pieces.chestplate?.[0]);
			const helm = byKey.get(s.pieces.helmet?.[0]);
			const [chestSrc, helmSrc] = await Promise.all([
				resolveGearIcon(base, chest?.icon, chest?.dyeColor),
				helm?.icon && helm.icon !== 'player_head' ? resolveGearIcon(base, helm.icon, helm.dyeColor) : Promise.resolve(''),
			]);
			setCardIcons[s.id] = { chestSrc, helmSrc };
		}),
	);
}

// Set-view data
const siblingSets = set ? sets.filter((s: any) => s.line === set.line) : [];
const allSetPieces = set ? SLOTS.flatMap(([slot]) => (set.pieces[slot] ?? []).map((k: string) => byKey.get(k)).filter(Boolean)) : [];
const isMultiPieceSet = set ? SLOTS.some(([slot]) => (set.pieces[slot] ?? []).length > 1) : false;
const setSummaryStats = set ? setStatSummary(set) : [];
const setSlotIcons = set
	? await Promise.all(
			SLOTS.map(async ([slot, label]) => {
				const first = byKey.get(set.pieces[slot]?.[0]);
				const src = await resolveGearIcon(base, first?.icon, first?.dyeColor);
				return { slot, label, icon: first?.icon ?? null, src, count: (set.pieces[slot] ?? []).length };
			}),
		)
	: [];

const weaponItems = set
	? set.weapons.flatMap((w: any) => w.items.map((k: string) => ({ item: byKey.get(k), bonus: w.bonus }))).filter((w: any) => w.item)
	: [];
const weaponNotes = Object.fromEntries(
	weaponItems
		.filter((w: any) => w.bonus.length)
		.map((w: any) => [w.item.key, w.bonus.map((b: string) => `Khi cầm: ${b}`)]),
);

const kindItems = view === 'kind' ? items.filter((i: any) => i.kind === kind) : [];
if (view === 'kind' && !kindItems.length) throw new Error(`RenEquipment: no items of kind "${kind}" in gear.json`);
---

<div class="rq not-content">
	{/* ===================== VIEW: ARMOR SETS CATALOG ===================== */}
	{
		view === 'sets' && (
			<div data-rqs-root>
				<div class="rqs-toolbar">
					<div class="rqs-search-row">
						<div class="rqs-search-box">
							<svg class="rqs-search-ico" viewBox="0 0 20 20" fill="none" aria-hidden="true">
								<circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.6" />
								<path d="M13 13l4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
							</svg>
							<input
								type="search"
								class="rqs-search"
								placeholder="Tìm tên bộ trang bị hoặc hiệu ứng (vd: Kháng Cự, hồi máu, Ngũ Hành, sát thương)..."
								aria-label="Tìm bộ trang bị"
								data-rqs-search
							/>
						</div>
						<label class="rqs-check">
							<input type="checkbox" data-rqs-weapons />
							<span>Có vũ khí kèm bộ</span>
						</label>
					</div>

					<div class="rqs-lines" role="tablist" aria-label="Lọc theo dòng trang bị">
						<button type="button" class="rqs-line-pill is-active" data-rqs-line="" role="tab" aria-selected="true">
							Tất cả <span class="rqs-pill-num">{sets.length}</span>
						</button>
						{data.lines.map((line: string) => {
							const lineCount = sets.filter((s: any) => s.line === line).length;
							return (
								<button type="button" class="rqs-line-pill" data-rqs-line={line} role="tab" aria-selected="false">
									{line} <span class="rqs-pill-num">{lineCount}</span>
								</button>
							);
						})}
					</div>

					<p class="rqs-status" data-rqs-status>
						Đang hiện {sets.length} bộ trang bị trong {data.lines.length} dòng
					</p>
				</div>

				{data.lines.map((line: string) => {
					const lineSets = sets.filter((s: any) => s.line === line);
					return (
						<section class="rqs-section" data-rqs-section={line}>
							<div class="rqs-sec-head">
								<h2 id={anchor(line)}>{line}</h2>
								<span class="rqs-sec-count">{lineSets.length} bộ</span>
							</div>
							<div class="rq-grid">
								{lineSets.map((s: any) => {
									const icons = setCardIcons[s.id] ?? { chestSrc: '', helmSrc: '' };
									const wCount = s.weapons.reduce((acc: number, w: any) => acc + w.items.length, 0);
									const stats = setStatSummary(s);
									const searchText = [
										s.name,
										s.line,
										...s.bonuses.flatMap((b: any) => b.lines),
									]
										.join(' ')
										.toLowerCase();

									return (
										<a
											class="rq-card"
											href={setUrl(s.slug)}
											data-rqs-card
											data-line={s.line}
											data-has-weapon={wCount > 0 ? '1' : '0'}
											data-search={searchText}
										>
											<div class="rq-card-top">
												<div class="rq-card-icons" aria-hidden="true">
													{icons.chestSrc && (
														<img src={icons.chestSrc} alt="" width="28" height="28" loading="lazy" onerror="this.style.display='none'" />
													)}
													{icons.helmSrc && (
														<img class="rq-card-helm" src={icons.helmSrc} alt="" width="18" height="18" loading="lazy" onerror="this.style.display='none'" />
													)}
												</div>
												<div class="rq-card-title-wrap">
													<strong class="rq-card-title">{s.name}</strong>
													<div class="rq-card-badges">
														{wCount > 0 && <span class="rq-badge rq-badge-weapon">+{wCount} vũ khí</span>}
														{stats.slice(0, 2).map((st) => (
															<span class="rq-badge">
																{st.label} {st.text}
															</span>
														))}
													</div>
												</div>
											</div>

											<div class="rq-card-bonuses">
												{s.bonuses.length > 0 ? (
													s.bonuses.map((b: any) => (
														<div class="rq-bonus-row">
															<span class:list={['rq-bonus-tag', { 'is-five': b.pieces === 5 }]}>
																{b.pieces === 4 ? '4 món' : b.pieces === 5 ? '+Vũ khí' : `${b.pieces} món`}
															</span>
															<span class="rq-bonus-text">{b.lines.map(bonusPreview).join(' · ')}</span>
														</div>
													))
												) : (
													<span class="rq-bonus-none">Không có hiệu ứng bộ riêng</span>
												)}
											</div>
										</a>
									);
								})}
							</div>
						</section>
					);
				})}

				<p class="rqs-empty" data-rqs-empty hidden>
					Không có bộ trang bị nào khớp với từ khóa tìm kiếm.{' '}
					<button type="button" class="rqs-reset" data-rqs-reset>
						Xem tất cả
					</button>
				</p>
			</div>
		)
	}

	{/* ===================== VIEW: SINGLE SET DETAIL ===================== */}
	{
		view === 'set' && set && (
			<div class="rqd" data-rqd-root>
				<div class="rqd-top-bar">
					<a class="rqd-back" href={`${base}/${server}/gear/bo-trang-bi/`}>
						← Danh sách bộ trang bị
					</a>
					<span class="rqd-line-badge">Dòng: {set.line}</span>
				</div>

				{siblingSets.length > 1 && (
					<nav class="rqd-siblings" aria-label={`Các bộ khác trong dòng ${set.line}`}>
						<span class="rqd-sib-label">Cùng dòng {set.line}:</span>
						<div class="rqd-sib-list">
							{siblingSets.map((sib: any) => (
								<a class:list={['rqd-sib-pill', { 'is-current': sib.id === set.id }]} href={setUrl(sib.slug)} aria-current={sib.id === set.id ? 'page' : undefined}>
									{sib.name}
								</a>
							))}
						</div>
					</nav>
				)}

				<div class="rqd-overview">
					<div class="rqd-slots-preview">
						{setSlotIcons.map((sl) => (
							<div class="rqd-slot-box">
								{sl.src ? (
									<img src={sl.src} alt="" width="28" height="28" onerror="this.style.display='none'" />
								) : (
									<span class="rqd-slot-empty">{sl.slot === 'helmet' ? '🪖' : '🛡'}</span>
								)}
								<span>{sl.label}</span>
								{sl.count > 1 && <small>{sl.count} bậc</small>}
							</div>
						))}
					</div>

					{setSummaryStats.length > 0 && (
						<div class="rqd-stats-summary">
							<div class="rqd-stats-label">Tổng chỉ số cơ bản (4 món giáp)</div>
							<div class="rqd-stats-grid">
								{setSummaryStats.map((st) => (
									<div class="rqd-stat-card">
										<span class="rqd-stat-name">{st.label}</span>
										<strong class="rqd-stat-val">{st.text}</strong>
									</div>
								))}
							</div>
						</div>
					)}
				</div>

				<h2 id="hieu-ung">Hiệu ứng bộ</h2>
				{set.bonuses.length > 0 ? (
					<div class:list={['rqd-bonus-grid', { 'is-single': set.bonuses.length === 1 }]}>
						{set.bonuses.map((b: any) => (
							<div class:list={['rqd-bonus-card', { 'is-five': b.pieces === 5 }]}>
								<div class="rqd-bonus-head">
									<span class="rqd-bonus-pill">{pieceText(b.pieces)}</span>
								</div>
								<ul>
									{b.lines.map((l: string) => (
										<li>{l}</li>
									))}
								</ul>
							</div>
						))}
					</div>
				) : (
					<p class="rq-meta">Bộ này không có hiệu ứng riêng khi mặc đủ 4 món.</p>
				)}

				<div class="rqd-section-head">
					<h2 id="giap">4 món giáp trong bộ</h2>
					{isMultiPieceSet && (
						<div class="rqd-slot-tabs" role="tablist" aria-label="Lọc theo món giáp">
							<button type="button" class="rqd-slot-tab is-active" data-rqd-slot="" role="tab" aria-selected="true">
								Tất cả ({allSetPieces.length})
							</button>
							{SLOTS.map(([slot, label]) => (
								<button type="button" class="rqd-slot-tab" data-rqd-slot={slot} role="tab" aria-selected="false">
									{label} ({set.pieces[slot].length})
								</button>
							))}
						</div>
					)}
				</div>

				<p class="rq-meta">Chỉ số cơ bản, phép có sẵn và công thức chế tạo bằng <code>/ecraft</code> cho từng món.</p>
				<div data-rqd-pieces>
					<RenItemTable items={allSetPieces} server={server} itemSets={itemSets} itemIndex={itemIndex} showSlot={true} />
				</div>

				{weaponItems.length > 0 && (
					<>
						<h2 id="vu-khi">Vũ khí của bộ ({weaponItems.length})</h2>
						<p class="rq-meta">Cầm một trong các vũ khí dưới đây cùng đủ 4 món giáp để kích hoạt hiệu ứng bộ (và hiệu ứng riêng nếu có).</p>
						<RenItemTable items={weaponItems.map((w: any) => w.item)} server={server} notes={weaponNotes} itemSets={itemSets} itemIndex={itemIndex} />
					</>
				)}
			</div>
		)
	}

	{/* ===================== VIEW: WEAPON / TOOL KIND CATALOG ===================== */}
	{
		view === 'kind' && (
			<RenItemTable items={kindItems} server={server} itemSets={itemSets} itemIndex={itemIndex} catalog={true} />
		)
	}
</div>

<script>
	// Armor sets catalog filtering
	document.querySelectorAll('[data-rqs-root]').forEach((root) => {
		const searchEl = root.querySelector('[data-rqs-search]') as HTMLInputElement | null;
		const weaponsEl = root.querySelector('[data-rqs-weapons]') as HTMLInputElement | null;
		const lineBtns = [...root.querySelectorAll('[data-rqs-line]')] as HTMLButtonElement[];
		const sections = [...root.querySelectorAll('[data-rqs-section]')] as HTMLElement[];
		const cards = [...root.querySelectorAll('[data-rqs-card]')] as HTMLElement[];
		const statusEl = root.querySelector('[data-rqs-status]') as HTMLElement | null;
		const emptyEl = root.querySelector('[data-rqs-empty]') as HTMLElement | null;
		let activeLine = '';

		function apply() {
			const q = (searchEl?.value ?? '').trim().toLowerCase();
			const withWeapons = Boolean(weaponsEl?.checked);
			let visibleCards = 0;
			let visibleSections = 0;

			for (const sec of sections) {
				const secLine = sec.dataset.rqsSection ?? '';
				if (activeLine && secLine !== activeLine) {
					sec.hidden = true;
					continue;
				}
				const secCards = [...sec.querySelectorAll('[data-rqs-card]')] as HTMLElement[];
				let hits = 0;
				for (const card of secCards) {
					const okQ = !q || (card.dataset.search ?? '').includes(q);
					const okW = !withWeapons || card.dataset.hasWeapon === '1';
					const ok = okQ && okW;
					card.hidden = !ok;
					if (ok) hits++;
				}
				sec.hidden = hits === 0;
				if (hits > 0) {
					visibleSections++;
					visibleCards += hits;
				}
			}

			if (statusEl) {
				statusEl.textContent = `Đang hiện ${visibleCards} bộ trang bị trong ${visibleSections} dòng`;
			}
			if (emptyEl) emptyEl.hidden = visibleCards > 0;
		}

		for (const btn of lineBtns) {
			btn.addEventListener('click', () => {
				activeLine = btn.dataset.rqsLine ?? '';
				for (const b of lineBtns) {
					const active = b === btn;
					b.classList.toggle('is-active', active);
					b.setAttribute('aria-selected', active ? 'true' : 'false');
				}
				apply();
			});
		}

		searchEl?.addEventListener('input', apply);
		weaponsEl?.addEventListener('change', apply);
		root.querySelector('[data-rqs-reset]')?.addEventListener('click', () => {
			if (searchEl) searchEl.value = '';
			if (weaponsEl) weaponsEl.checked = false;
			activeLine = '';
			for (const b of lineBtns) {
				const active = (b.dataset.rqsLine ?? '') === '';
				b.classList.toggle('is-active', active);
				b.setAttribute('aria-selected', active ? 'true' : 'false');
			}
			apply();
		});
	});

	// Multi-tier armor set slot filtering (e.g., Huyết Ma Vương 40 pieces)
	document.querySelectorAll('[data-rqd-root]').forEach((root) => {
		const tabs = [...root.querySelectorAll('[data-rqd-slot]')] as HTMLButtonElement[];
		if (!tabs.length) return;
		const rows = [...root.querySelectorAll('[data-rqd-pieces] tbody tr')] as HTMLTableRowElement[];
		const slotNames: Record<string, string> = { helmet: 'Mũ', chestplate: 'Áo', leggings: 'Quần', boots: 'Giày' };

		for (const tab of tabs) {
			tab.addEventListener('click', () => {
				const slot = tab.dataset.rqdSlot ?? '';
				for (const t of tabs) {
					const active = t === tab;
					t.classList.toggle('is-active', active);
					t.setAttribute('aria-selected', active ? 'true' : 'false');
				}
				const wantLabel = slot ? slotNames[slot] : '';
				for (const row of rows) {
					const label = row.querySelector('.rit-slot-badge')?.textContent?.trim() ?? '';
					row.hidden = Boolean(wantLabel && label !== wantLabel);
				}
			});
		}
	});
</script>

<style>
	.rq {
		margin: 1rem 0 2rem;
	}
	.rq h2 {
		margin: 1.5rem 0 0.35rem;
		font-size: var(--sl-text-xl);
		color: var(--tw-text);
	}
	.rq-meta {
		margin: 0.25rem 0 0.75rem;
		color: var(--tw-text-muted);
		font-size: 0.85rem;
	}

	/* Sets Toolbar */
	.rqs-toolbar {
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
		margin-bottom: 1.25rem;
		padding: 0.85rem;
		border: 1px solid var(--tw-border);
		border-radius: 0.5rem;
		background: var(--tw-surface);
	}
	.rqs-search-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		align-items: center;
	}
	.rqs-search-box {
		position: relative;
		flex: 1;
		min-width: 15rem;
		display: flex;
		align-items: center;
	}
