---
/**
 * Home-page cards, one per server, built from src/data/servers.mjs.
 * Each card opens the server's start page.
 */
import { CardGrid, LinkCard } from '@astrojs/starlight/components';
import { servers } from '../data/servers.mjs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<CardGrid>
	{servers.map((server) => <LinkCard title={server.title} description={server.description} href={`${base}/${server.slug}/`} />)}
</CardGrid>
