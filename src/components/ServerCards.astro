---
/**
 * Home-page cards, one per server, built from src/data/servers.mjs.
 * Each card opens the first page of the server's first system.
 */
import { CardGrid, LinkCard } from '@astrojs/starlight/components';
import { guides } from '../data/guides.mjs';
import { servers } from '../data/servers.mjs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// a server has no start page: its card opens the first page of its first system
const firstPage = (server: any) => {
	const guide = guides.find((g) => g.slug === server.guides[0]);
	if (!guide) throw new Error(`ServerCards: server "${server.slug}" lists unknown system "${server.guides[0]}"`);
	return `${base}/${server.slug}/${guide.slug}/${guide.landing}/`;
};
---

<CardGrid>
	{servers.map((server) => <LinkCard title={server.title} description={server.description} href={firstPage(server)} />)}
</CardGrid>
