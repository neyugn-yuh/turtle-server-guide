---
/** Group navigation shared by the enchant catalog and every group page. */
interface Props {
	server: string;
	groups: { slug: string; name: string; color: string | null; enchants: unknown[] }[];
	active?: string;
}

const { server, groups, active } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const root = `${base}/${server}/enchants`;
const tabs = [
	{ slug: undefined, name: 'Tất cả', color: null, count: groups.reduce((sum, group) => sum + group.enchants.length, 0) },
	...groups.map((group) => ({ ...group, count: group.enchants.length })),
];
---

<nav class="ren-nav" aria-label="Nhóm sách phép">
	<ul>
		{tabs.map((tab) => (
			<li>
				<a
					href={tab.slug ? `${root}/nhom/${tab.slug}/` : `${root}/danh-sach/`}
					aria-current={tab.slug === active ? 'page' : undefined}
				>
					<span class="ren-nav-name">
						{tab.color && <span class="ren-nav-dot" style={`--tier:${tab.color}`} aria-hidden="true" />}
						{tab.name}
					</span>
					<span class="ren-nav-count" aria-label={`${tab.count} sách phép`}>{tab.count}</span>
				</a>
			</li>
		))}
	</ul>
</nav>

<style>
	.ren-nav {
		margin-bottom: 1.5rem;
		padding: 0.4rem;
		border: 1px solid var(--tw-border);
		border-radius: 0.5rem;
		background: var(--tw-neutral);
	}
	.ren-nav ul {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
		gap: 0.35rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.ren-nav a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		min-height: 2.75rem;
		padding: 0.45rem 0.6rem;
		border: 1px solid transparent;
		border-radius: 0.375rem;
		color: var(--tw-text-nav);
		font-size: 0.8125rem;
		font-weight: 500;
		text-decoration: none;
	}
	.ren-nav a:hover {
		background: var(--tw-surface);
		color: var(--tw-text);
	}
	.ren-nav a[aria-current='page'] {
		border-color: var(--tw-green);
		background: var(--tw-accent-wash);
		color: var(--tw-accent-text);
		font-weight: 600;
	}
	.ren-nav a:focus-visible {
		outline: 2px solid var(--tw-accent-text);
		outline-offset: 2px;
	}
	.ren-nav-name {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
	}
	.ren-nav-dot {
		flex: 0 0 0.5rem;
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--tier);
		box-shadow: 0 0 0 1px var(--tw-border);
	}
	.ren-nav-count {
		padding: 0.05rem 0.35rem;
		border-radius: 0.25rem;
		background: var(--tw-surface);
		color: var(--tw-text-muted);
		font-size: 0.72rem;
		font-variant-numeric: tabular-nums;
	}
</style>
