---
/**
 * Reusable item catalog & table for Sky Rèn gear:
 * - Aggregates duplicate ingredients in /ecraft recipes (e.g. 5x instead of 1x repeated 5 times)
 *   and renders visual ingredient chips with pixel-art icons, costs and success rate pills.
 * - Surfaces vanilla enchants cleanly inline so combat-defining enchants (Sắc bén, Bảo vệ, Hiệu suất...)
 *   are readable at a glance rather than hidden behind a "Xem" toggle.
 * - Supports three modes:
 *     1) Catalog mode (`catalog=true`, used on weapon/tool kind pages): search, tier & set filters,
 *        and grouping by upgrade chain (e.g. "Kiếm Cổ Xưa (10 bậc)") vs flat compare table.
 *     2) Unified set armor mode (`showSlot=true`): shows Mũ/Áo/Quần/Giày together in one clean table.
 *     3) Standard flat mode: compact table with full inline details.
 */
import { hasMinionIcon, resolveGearIcon } from '../lib/ren-icons';

interface Props {
	items: any[];
	server?: string;
	/** extra text shown under the name of an item, keyed by item key (a set weapon's bonus) */
	notes?: Record<string, string[]>;
	/** map of item key -> array of { id, slug, name } sets the item belongs to */
	itemSets?: Record<string, { id: string; slug: string; name: string }[]>;
	/** map of item key -> { kind, slug, name, icon, dyeColor } for clickable prerequisite ingredient links */
	itemIndex?: Record<string, { kind: string; slug: string; name: string; icon?: string | null; dyeColor?: string | null }>;
	/** enable search, filters, and upgrade-chain grouping (used on kind pages) */
	catalog?: boolean;
	/** show slot label column (Mũ, Áo, Quần, Giày) for unified set armor tables */
	showSlot?: boolean;
}

const {
	items,
	server = 'sky-ren',
	notes = {},
	itemSets = {},
	itemIndex = {},
	catalog = false,
	showSlot = false,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const hasIcon = (icon: string | null | undefined) => hasMinionIcon(icon);
const resolvedIcons = new Map<string, string>();
const iconPairs: [string, string | null][] = [];
const queueIcon = (icon: string | null | undefined, dyeColor?: string | null) => {
	if (!hasIcon(icon)) return;
	const k = `${icon}::${dyeColor ?? ''}`;
	if (!resolvedIcons.has(k)) {
		resolvedIcons.set(k, '');
		iconPairs.push([icon!, dyeColor ?? null]);
	}
};
for (const i of items) {
	queueIcon(i.icon, i.dyeColor);
	for (const r of i.recipes ?? []) {
		for (const n of r.needs ?? []) {
			const linkedDye = n.item ? itemIndex[n.item]?.dyeColor : null;
			queueIcon(n.icon, linkedDye);
		}
	}
}
await Promise.all(
	iconPairs.map(async ([icon, dye]) => {
		resolvedIcons.set(`${icon}::${dye ?? ''}`, await resolveGearIcon(base, icon, dye));
	}),
);
const iconUrl = (icon: string | null | undefined, dyeColor?: string | null) =>
	hasIcon(icon) ? resolvedIcons.get(`${icon}::${dyeColor ?? ''}`) ?? '' : '';
const KIND_EMOJI: Record<string, string> = {
	helmet: '🪖',
	chestplate: '🛡',
	leggings: '🛡',
	boots: '🛡',
	shield: '🛡',
	bow: '🏹',
	pickaxe: '⛏',
	axe: '🪓',
	'farm-axe': '🪓',
	sword: '⚔',
};
const fallbackIcon = (kind?: string) => KIND_EMOJI[kind ?? ''] ?? '⚔';
const setUrl = (slug: string) => `${base}/${server}/gear/bo/${slug}/`;
const KIND_SLUGS: Record<string, string> = {
	sword: 'kiem',
	axe: 'riu',
	'farm-axe': 'riu-farm',
	bow: 'cung',
	shield: 'khien',
	pickaxe: 'cup',
};
const itemAnchor = (key: string) => key.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const ingredientHref = (n: any) => {
	if (!n.item || !itemIndex[n.item]) return undefined;
	const target = itemIndex[n.item];
	const kindSlug = KIND_SLUGS[target.kind];
	if (kindSlug) return `${base}/${server}/gear/${kindSlug}/#${itemAnchor(n.item)}`;
	const linkedSet = itemSets[n.item]?.[0];
	if (linkedSet) return `${base}/${server}/gear/bo/${linkedSet.slug}/#${itemAnchor(n.item)}`;
	return undefined;
};

const num = (x: number) => x.toLocaleString('vi-VN', { maximumFractionDigits: 3 });

const STATS: [string, string, string][] = [
	['armor', 'Giáp', ''],
	['defense', 'Phòng thủ', ''],
	['maxHealth', 'Máu tối đa', ''],
	['damageReduction', 'Giảm ST', '%'],
	['attackDamage', 'Sát thương', ''],
	['attackSpeed', 'Tốc đánh', ''],
];
const columns = STATS.filter(([key]) => items.some((i: any) => i.stats?.[key] !== undefined));

// Group identical ingredients in a recipe (e.g., 5 slots of 1x Mũ Bá Vương -> 5x Mũ Bá Vương)
function mergeNeeds(needs: any[]) {
	const merged: any[] = [];
	for (const n of needs) {
		const idKey = `${n.name}::${n.icon ?? ''}::${n.item ?? ''}`;
		const found = merged.find((m) => m._key === idKey);
		if (found) found.amount += n.amount;
		else merged.push({ ...n, _key: idKey });
	}
	return merged;
}

const PRIMARY_ENCHANTS = new Set(['Sắc bén', 'Sức mạnh', 'Bảo vệ', 'Hiệu suất', 'May mắn', 'Cướp bóc']);
function sortedEnchants(enchants: any[]) {
	return [...(enchants ?? [])].sort((a, b) => {
		const pa = PRIMARY_ENCHANTS.has(a.name) ? 0 : 1;
		const pb = PRIMARY_ENCHANTS.has(b.name) ? 0 : 1;
		if (pa !== pb) return pa - pb;
		return b.level - a.level;
	});
}

function isPrimaryEnchant(name: string) {
	return PRIMARY_ENCHANTS.has(name);
}

// Upgrade family grouping for catalog mode
function familyName(item: any) {
	return String(item.name)
		.replace(/^\d+\s+/, '')
		.replace(/\s+(?:\d+|Max)$/i, '')
		.trim();
}

function itemStepLabel(item: any, baseName: string) {
	const cleaned = String(item.name).replace(/^\d+\s+/, '').trim();
	if (cleaned === baseName) return 'Gốc';
	const suffix = cleaned.slice(baseName.length).trim();
	return suffix ? (suffix.toLowerCase() === 'max' ? 'Max' : `+${suffix}`) : 'Gốc';
}

interface FamilyGroup {
	id: string;
	name: string;
	icon: string | null;
	dyeColor: string | null;
	tierMin: number | null;
	tierMax: number | null;
	items: any[];
	sets: { id: string; slug: string; name: string }[];
	highlightStat: string | null;
	hasRecipe: boolean;
}

function buildFamilies(list: any[]): FamilyGroup[] {
	const map = new Map<string, any[]>();
	for (const item of list) {
		const fname = familyName(item);
		if (!map.has(fname)) map.set(fname, []);
		map.get(fname)!.push(item);
	}
	const out: FamilyGroup[] = [];
	for (const [fname, groupItems] of map) {
		const tiers = groupItems.map((i) => i.tier).filter((t) => Number.isFinite(t));
		const setMap = new Map<string, { id: string; slug: string; name: string }>();
		for (const i of groupItems) {
			for (const s of itemSets[i.key] ?? []) setMap.set(s.id, s);
		}
		// Compute a quick progression summary (e.g., Sắc bén 5 -> 95 or Máu 64 -> 72)
		const first = groupItems[0];
		const last = groupItems[groupItems.length - 1];
		let highlightStat: string | null = null;
		const mainEnc = sortedEnchants(first.enchants)[0];
		if (mainEnc && PRIMARY_ENCHANTS.has(mainEnc.name)) {
			const lastEnc = last.enchants.find((e: any) => e.name === mainEnc.name);
			if (groupItems.length > 1 && lastEnc && lastEnc.level !== mainEnc.level) {
				highlightStat = `${mainEnc.name} ${num(mainEnc.level)} → ${num(lastEnc.level)}`;
			} else {
				highlightStat = `${mainEnc.name} ${num(mainEnc.level)}`;
			}
		}
		if (first.stats?.maxHealth !== undefined) {
			const hpA = first.stats.maxHealth;
			const hpB = last.stats?.maxHealth;
			const hpStr = groupItems.length > 1 && hpB !== undefined && hpB !== hpA ? `Máu ${num(hpA)} → ${num(hpB)}` : `Máu ${num(hpA)}`;
			highlightStat = highlightStat ? `${hpStr} · ${highlightStat}` : hpStr;
		}
		out.push({
			id: itemAnchor(fname),
			name: fname,
			icon: first.icon,
			dyeColor: first.dyeColor ?? null,
			tierMin: tiers.length ? Math.min(...tiers) : null,
			tierMax: tiers.length ? Math.max(...tiers) : null,
			items: groupItems,
			sets: [...setMap.values()],
			highlightStat,
			hasRecipe: groupItems.some((i) => i.recipes?.length > 0),
		});
	}
	return out;
}

const families = catalog ? buildFamilies(items) : [];
const tiersAvailable = [...new Set(items.map((i) => i.tier).filter((t) => Number.isFinite(t)))].sort((a, b) => a - b);
const setsAvailable = [...new Map(items.flatMap((i) => itemSets[i.key] ?? []).map((s) => [s.id, s])).values()];
const hasAnySets = setsAvailable.length > 0;
const hasAnyNoRecipe = items.some((i) => !i.recipes?.length);
const showGroupingOption = catalog && families.length < items.length;
/** A note under an item name, "Khi cầm: Tăng 22% sát thương gây ra", split so the number stands out: { tag: 'Khi cầm', value: '+22%', text: 'sát thương gây ra' }. */
const parseNote = (line: string) => {
	const held = /^Khi cầm:\s*(.+)$/.exec(line);
	const body = held ? held[1] : line;
	const boost = /^Tăng\s+([\d.,]+%)\s+(.+)$/.exec(body);
	return { tag: held ? 'Khi cầm' : null, value: boost ? `+${boost[1]}` : null, text: boost ? boost[2] : body };
};
const uid = `rit-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="rit-wrap not-content" data-rit-root={uid} data-catalog={catalog ? '1' : '0'}>
	{
		catalog && (
			<div class="rit-toolbar">
				<div class="rit-search-box">
					<svg class="rit-search-ico" viewBox="0 0 20 20" fill="none" aria-hidden="true">
						<circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.6" />
						<path d="M13 13l4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
					</svg>
					<input
						type="search"
						class="rit-search"
						placeholder="Tìm tên vật phẩm, nguyên liệu, phép hoặc bộ giáp..."
						aria-label="Tìm trang bị"
						data-rit-search
					/>
				</div>

				<div class="rit-controls">
					{tiersAvailable.length > 1 && (
						<label class="rit-select-wrap">
							<span class="rit-sr">Lọc theo bậc</span>
							<select class="rit-select" data-rit-tier aria-label="Lọc theo bậc">
								<option value="">Mọi bậc ({tiersAvailable.length})</option>
								{tiersAvailable.map((t) => (
									<option value={String(t)}>Bậc {t}</option>
								))}
							</select>
						</label>
					)}

					{hasAnySets && (
						<label class="rit-select-wrap">
							<span class="rit-sr">Lọc theo bộ giáp</span>
							<select class="rit-select" data-rit-set aria-label="Lọc theo bộ giáp">
								<option value="">Mọi bộ / lẻ</option>
								<option value="__in_set__">Có bộ giáp ({setsAvailable.length})</option>
								<option value="__no_set__">Đồ lẻ (không thuộc bộ)</option>
								{setsAvailable.map((s) => (
									<option value={s.id}>Bộ {s.name}</option>
								))}
							</select>
						</label>
					)}

					{hasAnyNoRecipe && (
						<label class="rit-check">
							<input type="checkbox" data-rit-craftable />
							<span>Có công thức</span>
						</label>
					)}

					{showGroupingOption && (
						<div class="rit-view-toggle" role="group" aria-label="Chế độ hiển thị">
							<button type="button" class="rit-view-btn is-active" data-rit-mode="grouped">
								Theo chuỗi ({families.length})
							</button>
							<button type="button" class="rit-view-btn" data-rit-mode="flat">
								Bảng đầy đủ ({items.length})
							</button>
						</div>
					)}
				</div>

				<div class="rit-status-row">
					<span class="rit-status" data-rit-status>
						Đang hiện {items.length} vật phẩm{showGroupingOption ? ` trong ${families.length} dòng nâng cấp` : ''}
					</span>
					{showGroupingOption && (
						<div class="rit-bulk-btns" data-rit-bulk>
							<button type="button" class="rit-link-btn" data-rit-expand-all>Mở tất cả</button>
							<span aria-hidden="true">·</span>
							<button type="button" class="rit-link-btn" data-rit-collapse-all>Thu gọn</button>
						</div>
					)}
				</div>
			</div>
		)
	}

	{/* GROUPED FAMILY VIEW (for catalog pages with upgrade chains) */}
	{
		showGroupingOption && (
			<div class="rit-families" data-rit-grouped-panel>
				{families.map((fam) => {
					const single = fam.items.length === 1;
					const tierText =
						fam.tierMin === null
							? null
							: fam.tierMin === fam.tierMax
								? `Bậc ${fam.tierMin}`
								: `Bậc ${fam.tierMin}–${fam.tierMax}`;
					const searchTokens = fam.items
						.map((i) =>
							[
								i.name,
								i.id,
								...(itemSets[i.key] ?? []).map((s) => s.name),
								...i.enchants.map((e: any) => `${e.name} ${e.level}`),
								...i.recipes.flatMap((r: any) => r.needs.map((n: any) => n.name)),
							]
								.join(' ')
								.toLowerCase(),
						)
						.join(' | ');
					const famTiers = [...new Set(fam.items.map((i) => String(i.tier ?? '')))].join(',');
					const famSets = fam.sets.map((s) => s.id).join(',');

					return (
						<details
							class="rit-family"
							open={single || families.length <= 3}
							data-rit-family
							data-search={searchTokens}
							data-tiers={famTiers}
							data-sets={famSets}
							data-craftable={fam.hasRecipe ? '1' : '0'}
						>
							<summary class="rit-fam-head">
								<span class="rit-fam-left">
									<span class="rit-chev" aria-hidden="true">▸</span>
									<span class="rit-icon-box">
										{hasIcon(fam.icon) ? (
											<img
												src={iconUrl(fam.icon, fam.dyeColor)}
												alt=""
												width="28"
												height="28"
												loading="lazy"
												onerror="this.style.display='none';this.nextElementSibling.style.display='inline-flex'"
											/>
										) : null}
										<span class="rit-icon-fallback" style={hasIcon(fam.icon) ? 'display:none' : 'display:inline-flex'} aria-hidden="true">
											{fallbackIcon(fam.items[0]?.kind)}
										</span>
									</span>
									<span class="rit-fam-title-wrap">
										<strong class="rit-fam-title">{fam.name}</strong>
										<span class="rit-fam-meta">
											{!single && <span class="rit-pill rit-pill-muted">{fam.items.length} bậc</span>}
											{tierText && <span class="rit-pill rit-pill-tier">{tierText}</span>}
											{fam.highlightStat && <span class="rit-pill rit-pill-stat">{fam.highlightStat}</span>}
											{fam.sets.map((s) => (
												<span class="rit-pill rit-pill-set">Bộ {s.name}</span>
											))}
										</span>
									</span>
								</span>
							</summary>

							<div class="rit-fam-body">
								{fam.sets.length > 0 && (
									<div class="rit-fam-setbar">
										<span>Thuộc bộ trang bị:</span>
										{fam.sets.map((s) => (
											<a class="rit-set-link" href={setUrl(s.slug)}>
												Xem bộ {s.name} →
											</a>
										))}
									</div>
								)}
								<div class="rit-scroll">
									<table class="rit-table">
										<thead>
											<tr>
												<th>Vật phẩm</th>
												{columns.map(([, label]) => (
													<th class="rit-num-col">{label}</th>
												))}
												<th>Phép có sẵn</th>
												<th>Công thức chế tạo (<code>/ecraft</code>)</th>
											</tr>
										</thead>
										<tbody>
											{fam.items.map((i) => {
												const encs = sortedEnchants(i.enchants);
												const itemSetsList = itemSets[i.key] ?? [];
												const rowSearch = [
													i.name,
													i.id,
													...itemSetsList.map((s) => s.name),
													...encs.map((e: any) => `${e.name} ${e.level}`),
													...i.recipes.flatMap((r: any) => r.needs.map((n: any) => n.name)),
												]
													.join(' ')
													.toLowerCase();
												return (
													<tr
														id={itemAnchor(i.key)}
														data-rit-row
														data-search={rowSearch}
														data-tier={String(i.tier ?? '')}
														data-sets={itemSetsList.map((s) => s.id).join(',')}
														data-craftable={i.recipes.length > 0 ? '1' : '0'}
													>
														<td class="rit-item-cell">
															<div class="rit-item-title">
																<span class="rit-step-tag">{itemStepLabel(i, fam.name)}</span>
																<strong>{i.name}</strong>
															</div>
															{(notes[i.key] ?? []).map((line) => {
																const n = parseNote(line);
																return (
																	<div class="rit-held">
																		{n.tag && <span class="rit-held-tag">{n.tag}</span>}
																		{n.value && <strong class="rit-held-val">{n.value}</strong>}
																		<span class="rit-held-text">{n.text}</span>
																	</div>
																);
															})}
														</td>
														{columns.map(([key, , unit]) => (
															<td class="rit-num-col">{i.stats?.[key] !== undefined ? `${num(i.stats[key])}${unit}` : '–'}</td>
														))}
														<td class="rit-ench-cell">
															{encs.length > 0 ? (
																<div class="rit-ench-list">
																	{encs.map((e: any) => (
																		<span class:list={['rit-ench', { 'is-primary': isPrimaryEnchant(e.name) }]}>
																			{e.name} <b>{num(e.level)}</b>
																		</span>
																	))}
																</div>
															) : (
																<span class="rit-dash">–</span>
															)}
														</td>
														<td class="rit-recipe-cell">
															{i.recipes.length > 0 ? (
																<div class="rit-recipes">
																	{i.recipes.map((r: any, idx: number) => {
																		const needs = mergeNeeds(r.needs);
																		return (
																			<div class="rit-recipe-line">
																				{i.recipes.length > 1 && <span class="rit-recipe-idx">Cách {idx + 1}:</span>}
																				<div class="rit-chips">
																					{needs.map((n: any) => {
																						const href = ingredientHref(n);
																						const Tag = href ? 'a' : 'span';
																						return (
																							<Tag class:list={['rit-chip', { 'is-link': Boolean(href) }]} href={href}>
																								{hasIcon(n.icon) && (
																									<img
																										src={iconUrl(n.icon, n.item ? itemIndex[n.item]?.dyeColor : null)}
																										alt=""
																										width="16"
																										height="16"
																										loading="lazy"
																										onerror="this.style.display='none'"
																									/>
																								)}
																								<b>{num(n.amount)}×</b>
																								<span>{n.name}</span>
																							</Tag>
																						);
																					})}
																				</div>
																				{(r.money || r.xu || r.chance < 100) && (
																					<div class="rit-costs">
																						{r.money && <span class="rit-cost">{num(r.money)} tiền</span>}
																						{r.xu && <span class="rit-cost">{num(r.xu)} Xu</span>}
																						{r.chance < 100 && <span class="rit-cost is-warn">Tỉ lệ {num(r.chance)}%</span>}
																					</div>
																				)}
																			</div>
																		);
																	})}
																</div>
															) : (
																<span class="rit-no-recipe">Không chế tạo (rơi/đổi)</span>
															)}
														</td>
													</tr>
												);
											})}
										</tbody>
									</table>
								</div>
							</div>
						</details>
					);
				})}
			</div>
		)
	}

	{/* FLAT TABLE VIEW (default when not grouped, or toggled in catalog mode) */}
	<div class="rit-flat" data-rit-flat-panel style={showGroupingOption ? 'display:none' : undefined}>
		<div class="rit-scroll">
			<table class="rit-table">
				<thead>
					<tr>
						{showSlot && <th>Món</th>}
						<th>Vật phẩm</th>
						{columns.map(([, label]) => (
							<th class="rit-num-col">{label}</th>
						))}
						<th>Phép có sẵn</th>
						<th>Công thức chế tạo (<code>/ecraft</code>)</th>
					</tr>
				</thead>
				<tbody>
					{
						items.map((i: any) => {
							const encs = sortedEnchants(i.enchants);
							const itemSetsList = itemSets[i.key] ?? [];
							const rowSearch = [
								i.name,
								i.id,
								i.label,
								...itemSetsList.map((s) => s.name),
								...encs.map((e: any) => `${e.name} ${e.level}`),
								...i.recipes.flatMap((r: any) => r.needs.map((n: any) => n.name)),
							]
								.join(' ')
								.toLowerCase();
							return (
								<tr
									id={!showGroupingOption ? itemAnchor(i.key) : undefined}
									data-rit-flat-row
									data-search={rowSearch}
									data-tier={String(i.tier ?? '')}
									data-sets={itemSetsList.map((s) => s.id).join(',')}
									data-craftable={i.recipes.length > 0 ? '1' : '0'}
								>
									{showSlot && (
										<td class="rit-slot-cell">
											<span class="rit-slot-badge">{i.label}</span>
										</td>
									)}
									<td class="rit-item-cell">
										<div class="rit-item-title">
											<span class="rit-icon-box rit-icon-sm">
												{hasIcon(i.icon) ? (
													<img
														src={iconUrl(i.icon, i.dyeColor)}
														alt=""
														width="22"
														height="22"
														loading="lazy"
														onerror="this.style.display='none';this.nextElementSibling.style.display='inline-flex'"
													/>
												) : null}
												<span class="rit-icon-fallback" style={hasIcon(i.icon) ? 'display:none' : 'display:inline-flex'} aria-hidden="true">
													{fallbackIcon(i.kind)}
												</span>
											</span>
											<div>
												<strong>{i.name}</strong>
												{catalog && itemSetsList.length > 0 && (
													<div class="rit-inline-sets">
														{itemSetsList.map((s) => (
															<a class="rit-inline-set" href={setUrl(s.slug)}>
																Bộ {s.name}
															</a>
														))}
													</div>
												)}
											</div>
										</div>
										{(notes[i.key] ?? []).map((line) => {
											const n = parseNote(line);
											return (
												<div class="rit-held">
													{n.tag && <span class="rit-held-tag">{n.tag}</span>}
													{n.value && <strong class="rit-held-val">{n.value}</strong>}
													<span class="rit-held-text">{n.text}</span>
												</div>
											);
										})}
									</td>
									{columns.map(([key, , unit]) => (
										<td class="rit-num-col">{i.stats?.[key] !== undefined ? `${num(i.stats[key])}${unit}` : '–'}</td>
									))}
									<td class="rit-ench-cell">
										{encs.length > 0 ? (
											<div class="rit-ench-list">
												{encs.map((e: any) => (
													<span class:list={['rit-ench', { 'is-primary': isPrimaryEnchant(e.name) }]}>
														{e.name} <b>{num(e.level)}</b>
													</span>
												))}
											</div>
										) : (
											<span class="rit-dash">–</span>
										)}
									</td>
									<td class="rit-recipe-cell">
										{i.recipes.length > 0 ? (
											<div class="rit-recipes">
												{i.recipes.map((r: any, idx: number) => {
													const needs = mergeNeeds(r.needs);
													return (
														<div class="rit-recipe-line">
															{i.recipes.length > 1 && <span class="rit-recipe-idx">Cách {idx + 1}:</span>}
															<div class="rit-chips">
																{needs.map((n: any) => {
																	const href = ingredientHref(n);
																	const Tag = href ? 'a' : 'span';
																	return (
																		<Tag class:list={['rit-chip', { 'is-link': Boolean(href) }]} href={href}>
																			{hasIcon(n.icon) && (
																				<img
																					src={iconUrl(n.icon, n.item ? itemIndex[n.item]?.dyeColor : null)}
																					alt=""
																					width="16"
																					height="16"
																					loading="lazy"
																					onerror="this.style.display='none'"
																				/>
																			)}
																			<b>{num(n.amount)}×</b>
																			<span>{n.name}</span>
																		</Tag>
																	);
																})}
															</div>
															{(r.money || r.xu || r.chance < 100) && (
																<div class="rit-costs">
																	{r.money && <span class="rit-cost">{num(r.money)} tiền</span>}
																	{r.xu && <span class="rit-cost">{num(r.xu)} Xu</span>}
																	{r.chance < 100 && <span class="rit-cost is-warn">Tỉ lệ {num(r.chance)}%</span>}
																</div>
															)}
														</div>
													);
												})}
											</div>
										) : (
											<span class="rit-no-recipe">Không chế tạo (rơi/đổi)</span>
										)}
									</td>
								</tr>
							);
						})
					}
				</tbody>
			</table>
		</div>
	</div>

	{
		catalog && (
			<p class="rit-empty" data-rit-empty hidden>
				Không tìm thấy vật phẩm nào khớp với bộ lọc hiện tại. <button type="button" class="rit-link-btn" data-rit-reset>Xóa bộ lọc</button>
			</p>
		)
	}
</div>

<script>
	document.querySelectorAll('[data-rit-root][data-catalog="1"]').forEach((root) => {
		const searchEl = root.querySelector('[data-rit-search]') as HTMLInputElement | null;
		const tierEl = root.querySelector('[data-rit-tier]') as HTMLSelectElement | null;
		const setEl = root.querySelector('[data-rit-set]') as HTMLSelectElement | null;
		const craftEl = root.querySelector('[data-rit-craftable]') as HTMLInputElement | null;
		const statusEl = root.querySelector('[data-rit-status]') as HTMLElement | null;
		const emptyEl = root.querySelector('[data-rit-empty]') as HTMLElement | null;
		const groupedPanel = root.querySelector('[data-rit-grouped-panel]') as HTMLElement | null;
		const flatPanel = root.querySelector('[data-rit-flat-panel]') as HTMLElement | null;
		const bulkWrap = root.querySelector('[data-rit-bulk]') as HTMLElement | null;
		const modeBtns = [...root.querySelectorAll('[data-rit-mode]')] as HTMLButtonElement[];

		let mode: 'grouped' | 'flat' = groupedPanel ? 'grouped' : 'flat';

		const families = [...root.querySelectorAll('[data-rit-family]')] as HTMLDetailsElement[];
		const flatRows = [...root.querySelectorAll('[data-rit-flat-row]')] as HTMLTableRowElement[];

		function matches(el: HTMLElement, q: string, tier: string, setVal: string, craftOnly: boolean) {
			if (q && !(el.dataset.search ?? '').includes(q)) return false;
			if (tier) {
				const t = el.dataset.tier ?? el.dataset.tiers ?? '';
				if (!t.split(',').includes(tier)) return false;
			}
			if (setVal) {
				const sets = (el.dataset.sets ?? '').split(',').filter(Boolean);
				if (setVal === '__in_set__' && sets.length === 0) return false;
				else if (setVal === '__no_set__' && sets.length > 0) return false;
				else if (setVal !== '__in_set__' && setVal !== '__no_set__' && !sets.includes(setVal)) return false;
			}
			if (craftOnly && el.dataset.craftable !== '1') return false;
			return true;
		}

		function applyFilter() {
			const q = (searchEl?.value ?? '').trim().toLowerCase();
			const tier = tierEl?.value ?? '';
			const setVal = setEl?.value ?? '';
			const craftOnly = Boolean(craftEl?.checked);
			const filtering = Boolean(q || tier || setVal || craftOnly);

			let visibleItems = 0;
			let visibleFamilies = 0;

			if (groupedPanel) {
				for (const fam of families) {
					const rows = [...fam.querySelectorAll('[data-rit-row]')] as HTMLTableRowElement[];
					let famHits = 0;
					for (const row of rows) {
						const ok = matches(row, q, tier, setVal, craftOnly);
						row.hidden = !ok;
						if (ok) famHits++;
					}
					fam.hidden = famHits === 0;
					if (famHits > 0) {
						visibleFamilies++;
						visibleItems += famHits;
						if (filtering && famHits <= 12) fam.open = true;
					}
				}
			}

			let flatHits = 0;
			for (const row of flatRows) {
				const ok = matches(row, q, tier, setVal, craftOnly);
				row.hidden = !ok;
				if (ok) flatHits++;
			}
			if (!groupedPanel) visibleItems = flatHits;

			if (statusEl) {
				statusEl.textContent =
					mode === 'grouped' && groupedPanel
						? `Đang hiện ${visibleItems} vật phẩm trong ${visibleFamilies} dòng nâng cấp`
						: `Đang hiện ${flatHits} vật phẩm`;
			}
			if (emptyEl) emptyEl.hidden = visibleItems > 0;
		}

		function setMode(next: 'grouped' | 'flat') {
			mode = next;
			if (groupedPanel) groupedPanel.style.display = mode === 'grouped' ? '' : 'none';
			if (flatPanel) flatPanel.style.display = mode === 'flat' ? '' : 'none';
			if (bulkWrap) bulkWrap.style.display = mode === 'grouped' ? '' : 'none';
			for (const btn of modeBtns) btn.classList.toggle('is-active', btn.dataset.ritMode === mode);
			applyFilter();
		}

		searchEl?.addEventListener('input', applyFilter);
		tierEl?.addEventListener('change', applyFilter);
		setEl?.addEventListener('change', applyFilter);
		craftEl?.addEventListener('change', applyFilter);

		for (const btn of modeBtns) {
			btn.addEventListener('click', () => {
				const m = btn.dataset.ritMode === 'flat' ? 'flat' : 'grouped';
				setMode(m);
			});
		}

		root.querySelector('[data-rit-expand-all]')?.addEventListener('click', () => {
			for (const fam of families) if (!fam.hidden) fam.open = true;
		});
		root.querySelector('[data-rit-collapse-all]')?.addEventListener('click', () => {
			for (const fam of families) fam.open = false;
		});
		root.querySelector('[data-rit-reset]')?.addEventListener('click', () => {
			if (searchEl) searchEl.value = '';
			if (tierEl) tierEl.value = '';
			if (setEl) setEl.value = '';
			if (craftEl) craftEl.checked = false;
			applyFilter();
		});

		// If URL hash points to a specific item inside a collapsed family, open that family!
		function openHashTarget() {
			const hash = location.hash.slice(1);
			if (!hash) return;
			const target = root.querySelector(`#${CSS.escape(hash)}`) as HTMLElement | null;
			const parentDetails = target?.closest('details') as HTMLDetailsElement | null;
			if (parentDetails) {
				parentDetails.open = true;
				target?.scrollIntoView({ block: 'center' });
			}
		}
		openHashTarget();
		window.addEventListener('hashchange', openHashTarget);
	});
</script>

