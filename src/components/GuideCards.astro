---
/**
 * Cards for the systems of one server: the list comes from src/data/servers.mjs, the names from src/data/guides.mjs.
 * Each card opens the system's Overview page.
 */
import { CardGrid, LinkCard } from '@astrojs/starlight/components';
import { guides } from '../data/guides.mjs';
import { servers } from '../data/servers.mjs';

interface Props {
	server: string;
}

const { server } = Astro.props;
const entry = servers.find((s) => s.slug === server);
if (!entry) throw new Error(`GuideCards: unknown server "${server}"`);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const list = entry.guides.map((slug) => {
	const guide = guides.find((g) => g.slug === slug);
	if (!guide) throw new Error(`GuideCards: server "${server}" lists unknown system "${slug}"`);
	return guide;
});
---

<CardGrid>
	{list.map((guide) => <LinkCard title={guide.title} description={guide.description} href={`${base}/${server}/${guide.slug}/overview/`} />)}
</CardGrid>
